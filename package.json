{
  "name": "aphw-ddi-documents",
  "version": "0.8.1",
  "description": "Document management and creation",
  "homepage": "https://github.com/DEFRA/aphw-ddi-documents",
  "main": "app/index.js",
  "scripts": {
    "pretest": "npm run test:lint",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPatterns=test/unit --coverage=false",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:lint": "standard",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch app/index.js"
  },
  "author": "Defra",
  "contributors": [],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.17.0",
    "@hapi/hapi": "^21.4.10",
    "applicationinsights": "^3.16.0",
    "date-fns": "^3.2.0",
    "axios": "^1.7.7",
    "fast-xml-parser": "^5.11.2",
    "ffc-messaging": "^2.10.10",
    "joi": "^17.13.8",
    "log-timestamp": "^0.3.0",
    "moment": "^2.29.4",
    "notifications-node-client": "^8.2.0",
    "pdfkit": "^0.14.0",
    "pdfkit-table": "^0.1.99",
    "pdf-lib": "^1.17.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.0.1",
    "standard": "^17.1.2"
  },
  "standard": {
    "globals": [
      "describe",
      "beforeEach",
      "expect",
      "test",
      "afterEach",
      "jest",
      "beforeAll",
      "afterAll"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  },
  "overrides": {
    "uuid": "$uuid"
  }
}